# Copy to .env and fill in for local development.

DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# CORS: the frontend origin allowed to call this API.
WEB_ORIGIN="http://localhost:5173"

# --- Optional: real SMS/WhatsApp delivery via Twilio ---
# Leave any of these unset to run in "logged only" mode: escalation alerts
# are still recorded in AlertLog, but no real message is sent.
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your_auth_token"
# TWILIO_SMS_FROM="+15005550006"
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
